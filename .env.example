# Node.js >= 24.0.0. Copy this file to .env for local customization.
# Simulation only: no physical device connection is enabled.
HOST=127.0.0.1
PORT=8788
DB_PATH=./data/park-v1.1.sqlite
# Replace before exposing the backend beyond this machine.
SIMULATOR_TOKEN=bailuwan-local-simulator-change-me
# Optional backend origin for the standalone simulator.
API_BASE=http://127.0.0.1:8788
SIMULATOR_INTERVAL_MS=2000

# Default: local rules, with no model traffic. Set AI_MODE=model explicitly to opt in.
# DeepSeek reads credentials only in the backend; never put keys in VITE_* variables.
AI_MODE=rules
AI_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=30000
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_FILE=
# Optional alternate OpenAI-compatible/local model provider (AI_PROVIDER=openai-compatible).
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_PROTOCOL=responses
OPENAI_TIMEOUT_MS=20000
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
# Optional: separate cookies when running independent local demos on different ports.
SESSION_COOKIE_NAME=blw_session_v11
